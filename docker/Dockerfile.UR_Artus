ARG ROS_DISTRO=jazzy
FROM osrf/ros:${ROS_DISTRO}-desktop

ARG WS=/ros2_ws
WORKDIR $WS/src 

# --- System Setup (Run as Root) ---
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    wget \
    python3-colcon-common-extensions \
    python3-vcstool \
    python3-rosdep \
    python3-pip \
    python3-venv \
    python-is-python3 \
    nvidia-cuda-toolkit \
    iproute2 \
    net-tools \
    iputils-ping \
    nmap \
    ethtool \
    python3-pymodbus \
    libvulkan1 \   
    mesa-vulkan-drivers\ 
    vulkan-tools \
    libmodbus-dev \
    ros-${ROS_DISTRO}-ros2-control \
    ros-${ROS_DISTRO}-ros2-controllers \
    ros-${ROS_DISTRO}-moveit \
    ros-${ROS_DISTRO}-moveit-setup-assistant \
    ros-${ROS_DISTRO}-ur-description \
    ros-${ROS_DISTRO}-ur-moveit-config \
    ros-${ROS_DISTRO}-ur-robot-driver \
    ros-$ROS_DISTRO-pinocchio \
    ros-${ROS_DISTRO}-ur-calibration \
    ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
    ros-${ROS_DISTRO}-iceoryx-binding-c \
    && rm -rf /var/lib/apt/lists/*

# --- Workaround to avoid rviz moveit bug ---
RUN wget http://snapshots.ros.org/jazzy/2025-05-23/ubuntu/pool/main/r/ros-jazzy-rviz-common/ros-jazzy-rviz-common_14.1.11-1noble.20250520.201719_amd64.deb
RUN sudo dpkg -i ros-jazzy-rviz-common_14.1.11-1noble.20250520.201719_amd64.deb
RUN rm -rf ros-jazzy-rviz-common_14.1.11-1noble.20250520.201719_amd64.deb

# --- Workspace Setup ---
WORKDIR $WS

 # rosdep init
RUN rosdep init || true && rosdep update 

RUN rosdep install --from-paths src --ignore-src -r -y --rosdistro ${ROS_DISTRO}

# Build
RUN . /opt/ros/${ROS_DISTRO}/setup.sh \
 && colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Release

# --- Environment Configuration ---
RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> /home/.bashrc \
 && echo "source $WS/install/setup.bash" >> /home/.bashrc

# CUDA Environment
ENV CUDA_HOME=/usr/lib/nvidia-cuda-toolkit
ENV PATH=${CUDA_HOME}/bin:${PATH}
ENV PYTHONPATH=$PYTHONPATH:/ros2_ws/src/il_main/il/venv/lib/python3.12/site-packages
ENV LD_LIBRARY_PATH=${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}

CMD ["/bin/bash"]