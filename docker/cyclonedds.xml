<?xml version="1.0" encoding="UTF-8" ?>
<CycloneDDS xmlns="https://cdds.io/config" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://cdds.io/config https://raw.githubusercontent.com/eclipse-cyclonedds/cyclonedds/master/etc/cyclonedds.xsd">
    <Domain id="any">
        <General>
            <!-- Moderne Syntax für Netzwerkkarten -->
            <Interfaces>
                <NetworkInterface name="lo"/>
            </Interfaces>
            <!-- Multicast explizit verbieten, da 'lo' es eh nicht nutzt -->
            <AllowMulticast>false</AllowMulticast>
            <MaxMessageSize>65500B</MaxMessageSize>
        </General>
        <Discovery>
            <!-- Unicast-only discovery on 'lo' assigns every participant a
                 numbered port slot. The default limit is 9, which is quickly
                 exhausted here: ros2_control_node + 8 controllers +
                 robot_state_publisher + mapper + spawners all share the same
                 range, across ALL host-network containers (ur_artus,
                 senseglove_*). Exceeding it fails with
                 "Failed to find a free participant index for domain 0". -->
            <MaxAutoParticipantIndex>60</MaxAutoParticipantIndex>
        </Discovery>
        <Internal>
            <Watermarks>
                <WhcHigh>500kB</WhcHigh>
            </Watermarks>
        </Internal>
        <Tracing>
            <!-- Auf 'warning' belassen, damit nur echte Fehler auftauchen -->
            <Verbosity>warning</Verbosity>
            <OutputFile>stdout</OutputFile>
        </Tracing>
    </Domain>
</CycloneDDS>