# =============================================================================
# Production Inference Container for ManiFlow Policy Deployment
# =============================================================================
ARG ROS_DISTRO=jazzy

FROM ros:${ROS_DISTRO}-perception

ARG ROS_DISTRO=jazzy
ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=${ROS_DISTRO}
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# 1. Install base utilities & build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl gnupg2 ca-certificates \
    git build-essential cmake python3-pip python3-dev python-is-python3 \
    ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
    ros-${ROS_DISTRO}-cv-bridge \
    ros-${ROS_DISTRO}-sensor-msgs-py \
    ros-${ROS_DISTRO}-action-msgs \
    ros-${ROS_DISTRO}-rosidl-default-generators \
    ros-${ROS_DISTRO}-rosidl-default-runtime \
    python3-colcon-common-extensions \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# 2. Install PyTorch stack and ManiFlow ML dependencies directly (no venv)
ENV PIP_BREAK_SYSTEM_PACKAGES=1
RUN pip3 install --no-cache-dir --ignore-installed \
    torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu124

RUN pip3 install --no-cache-dir --ignore-installed \
    "diffusers>=0.27.0" accelerate transformers timm einops \
    "hydra-core>=1.3.2" hydra-colorlog omegaconf \
    "numpy<2.0.0" h5py zarr numcodecs scipy scikit-learn \
    opencv-python-headless open3d imageio imageio-ffmpeg matplotlib \
    kinpy pyyaml

# 3. Install pytorch3d (required for PointNet & farthest point sampling)
RUN pip3 install --no-cache-dir --ignore-installed --extra-index-url https://miropsota.github.io/torch_packages_builder pytorch3d || \
    pip3 install --no-cache-dir --ignore-installed "git+https://github.com/facebookresearch/pytorch3d.git@v0.7.8"

# 4. Setup Robot Models / URDFs
WORKDIR /ros2_ws
RUN mkdir -p /ros2_ws/models

# Copy all workcell URDFs (UR10e + Hands, and slot for future UR8L / custom workcells)
COPY src/moveit_ur_hand_config/urdf/ /ros2_ws/models/

# Default robot kinematics: UR10e Tesollo (kann per ENV oder Mount auf UR8L umgestellt werden)
ENV ROBOT_NAME="ur10e_tesollo"
ENV URDF_PATH=/ros2_ws/models/tesollo_hand_ur10e_flange_workcell.urdf
ENV ROBOT_TIP_FRAME=tool0

# 5. Copy ManiFlow Policy and Action Interfaces into workspace
COPY src/maniflow_msgs /ros2_ws/src/maniflow_msgs
COPY third_party/ManiFlow_Policy/ManiFlow /ros2_ws/src/maniflow

# Install ManiFlow package in Python
RUN pip3 install --ignore-installed -e /ros2_ws/src/maniflow

# Build ROS 2 workspace (maniflow_msgs action interface)
RUN . /opt/ros/${ROS_DISTRO}/setup.sh \
    && colcon build --cmake-args -DCMAKE_BUILD_TYPE=Release

# 6. Environment & Entrypoint
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,video
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ENV PYTHONPATH="/ros2_ws/src/maniflow:/ros2_ws/install/maniflow_msgs/local/lib/python3.12/dist-packages"

COPY docker/production/entrypoint.sh /ros_entrypoint.sh

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["python3", "/ros2_ws/src/maniflow/policy_action_server.py"]
