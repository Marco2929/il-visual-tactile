# Thin overlay on the prebuilt SenseGlove image that adds Cyclone DDS.
#
# WHY THIS EXISTS
# The SenseGlove image ships only Fast DDS (librmw_fastrtps_cpp.so). The rest
# of this workspace (ros2_dev, zed_container, ur_artus, ...) runs Cyclone DDS
# pinned to the loopback interface via docker/cyclonedds.xml. Fast DDS and
# Cyclone DDS do not interoperate, so the DG5F joint states never reached the
# recording node.
#
# Two directions were possible. Switching the whole workspace to Fast DDS would
# touch every container and additionally fails on shared memory: Fast DDS
# prefers SHM for same-host traffic and the containers run with
# IpcMode=private, so the segments are not visible across them. Adding Cyclone
# to the SenseGlove side is the smaller change and leaves the working stack
# alone - that is what this file does.
#
# Verified in a running container before writing this: the package installs
# cleanly from the ROS 2 apt repo already configured in the image, and with
# CYCLONEDDS_URI pointing at docker/cyclonedds.xml the SenseGlove container
# could list 28 topics from ros2_dev. The install does not survive a restart
# (compose runs the container with --rm), hence this image layer.
#
# BUILD
#   cd src/senseglove/distribution
#   bash build_cyclone_image.sh
#
# RUN (note the tag)
#   uv run start.py tesollo --tag cyclone-latest --hand right --glove-id 70

ARG BASE_IMAGE=zippeth/senseglove_robotics:latest
FROM ${BASE_IMAGE}

# rmw_cyclonedds_cpp pulls in cyclonedds, iceoryx-hoofs and iceoryx-posh.
#
# topic_tools provides the `relay` node used to republish
# /dg5f_right/joint_states onto /joint_states. MoveIt's planning scene monitor
# only subscribes to /joint_states, and ur_tesollo_moveit.launch.py no longer
# starts tesollo_control (it would fight this container for Modbus 502), so
# without the relay move_group/servo_node warn forever about missing
# rj_dg_* joints. The monitor merges publishers by joint name, so the UR's 6
# joints and the hand's 20 coexist on that topic.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ros-jazzy-rmw-cyclonedds-cpp \
        ros-jazzy-topic-tools \
    && rm -rf /var/lib/apt/lists/*

# Defaults; docker-compose overrides these per service anyway.
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp \
    CYCLONEDDS_URI=file:///tmp/cyclonedds.xml
