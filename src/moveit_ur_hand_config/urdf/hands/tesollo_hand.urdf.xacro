<?xml version="1.0"?>
<robot name="tesollo_hand" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="delto_ip" default="169.254.186.72" />
    <xacro:arg name="delto_port" default="502" />
    <xacro:arg name="delto_model" default="24354" />
    <xacro:arg name="fingertip_sensor" default="false" />
    <xacro:arg name="io" default="false" />

    <xacro:arg name="base_type" default="default" />
    <xacro:arg name="with_mount" default="true" />

    <xacro:include filename="$(find dg_description)/urdf/dg5f_macro.xacro" />

    <xacro:macro name="tesollo_hand_macro" params="prefix parent *origin">

        <xacro:property name="fs" value="$(arg fingertip_sensor)" />
        <xacro:property name="tip_type" value="${'type1' if str(fs).lower() == 'true' else 'default'}" />

        <joint name="${prefix}tesollo_base_joint" type="fixed">
            <xacro:insert_block name="origin" />
            <parent link="${parent}" />
            <child link="rl_dg_base_link" />
        </joint>

        <xacro:dg5f_hand 
            side="right"
            base_type="$(arg base_type)"
            with_mount="$(arg with_mount)"
            tip1_type="${tip_type}"
            tip2_type="${tip_type}"
            tip3_type="${tip_type}"
            tip4_type="${tip_type}"
            tip5_type="${tip_type}"
        />

        <xacro:if value="${str(fs).lower() == 'true'}">
            <link name="right_fingertip_1" />
            <joint name="right_fingertip_1_joint" type="fixed">
                <parent link="rl_dg_1_tip" />
                <child link="right_fingertip_1" />
                <origin xyz="0 0.0128 0.0045" rpy="0 0 -1.5708" />
            </joint>

            <link name="right_fingertip_2" />
            <joint name="right_fingertip_2_joint" type="fixed">
                <parent link="rl_dg_2_tip" />
                <child link="right_fingertip_2" />
                <origin xyz="0.0045 0 0.0128" rpy="0 1.5708 0" />
            </joint>

            <link name="right_fingertip_3" />
            <joint name="right_fingertip_3_joint" type="fixed">
                <parent link="rl_dg_3_tip" />
                <child link="right_fingertip_3" />
                <origin xyz="0.0045 0 0.0128" rpy="0 1.5708 0" />
            </joint>

            <link name="right_fingertip_4" />
            <joint name="right_fingertip_4_joint" type="fixed">
                <parent link="rl_dg_4_tip" />
                <child link="right_fingertip_4" />
                <origin xyz="0.0045 0 0.0128" rpy="0 1.5708 0" />
            </joint>

            <link name="right_fingertip_5" />
            <joint name="right_fingertip_5_joint" type="fixed">
                <parent link="rl_dg_5_tip" />
                <child link="right_fingertip_5" />
                <origin xyz="0.0045 0 0.0128" rpy="0 1.5708 0" />
            </joint>
        </xacro:if>

        <ros2_control name="DG5FRightHardware" type="system">
            <hardware>
                <plugin>delto_hardware/SystemInterface</plugin>
                <param name="delto_ip">$(arg delto_ip)</param>
                <param name="delto_port">$(arg delto_port)</param>
                <param name="delto_model">$(arg delto_model)</param>
                <param name="hand_type">right</param>
                <param name="fingertip_sensor">$(arg fingertip_sensor)</param>
                <param name="IO">$(arg io)</param>
            </hardware>

            <joint name="rj_dg_1_1">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>
            <joint name="rj_dg_1_2">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>
            <joint name="rj_dg_1_3">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>
            <joint name="rj_dg_1_4">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>

            <joint name="rj_dg_2_1">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>
            <joint name="rj_dg_2_2">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>
            <joint name="rj_dg_2_3">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>
            <joint name="rj_dg_2_4">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>

            <joint name="rj_dg_3_1">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>
            <joint name="rj_dg_3_2">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>
            <joint name="rj_dg_3_3">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>
            <joint name="rj_dg_3_4">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>

            <joint name="rj_dg_4_1">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>
            <joint name="rj_dg_4_2">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>
            <joint name="rj_dg_4_3">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>
            <joint name="rj_dg_4_4">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>

            <joint name="rj_dg_5_1">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>
            <joint name="rj_dg_5_2">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>
            <joint name="rj_dg_5_3">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>
            <joint name="rj_dg_5_4">
                <command_interface name="effort" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>
        </ros2_control>

    </xacro:macro>

</robot>