# ─── Data Server Configuration ──────────────────────────────────────────────
# Used by dataset_builder when `output.push_to_server` is configured.
# You can override any of these with system environment variables.

# Default upload behavior (disabled by default unless set to true)
DATASET_SERVER_ENABLED=false

# Target server IP or hostname (reachable via LAN)
DATASET_SERVER=192.168.50.44

# SSH user on the target server
DATASET_SERVER_USER=dataset_server

# Path to SSH private key (expands '~' on host or container)
DATASET_SERVER_KEY=~/.ssh/prehensio_upload

# Remote data root path on the server
DATASET_SERVER_ROOT=/data/prehensio_data

# When true, an existing dataset on the server is moved to datasets_replaced/<name>.<timestamp>
# rather than aborting.
DATASET_SERVER_REPLACE=true

# Prehensio visualizer web port
DATASET_SERVER_VIEWER_PORT=8080
